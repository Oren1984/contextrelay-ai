# Copy to .env only if you want to change a default. The app runs fully offline without this file.

# Optional LLM suggestions. Disabled by default; Mock mode is used instead.
# Enabling it also requires the optional dependency in requirements-llm.txt.
CONTEXTRELAY_LLM_ENABLED=false
CONTEXTRELAY_LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

CONTEXTRELAY_LOG_LEVEL=INFO
